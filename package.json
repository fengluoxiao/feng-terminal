{
  "name": "tui-ai-terminal",
  "version": "0.1.0",
  "description": "A Warp-like AI terminal shell for OpenCode, Codex CLI, Antigravity CLI, Claude Code, and Kimi CLI.",
  "main": "./out/main/index.js",
  "author": "Legendshop",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "simple-liquid-glass": "^4.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.4.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
